# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mini-crm

# Optional DNS resolvers for Atlas SRV discovery.
# When unset, development defaults to Google DNS and production uses system DNS.
MONGO_DNS_SERVERS=8.8.8.8

# Secret used to sign auth tokens (use a long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-string

# Seed-only credential; keep private and set this before running seed:demo.
DEMO_PASSWORD=replace-with-a-private-demo-password

# URL of the frontend that's allowed to call this API (CORS allowlist)
# Optional on initial backend deployment before the frontend URL is known.
# When unset, the backend starts and responds to health checks, but blocks browser origins.
# Local dev: http://localhost:5173
# Deployed: the live Vercel/Netlify frontend URL
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development

# Port the server listens on (optional, defaults to 4000)
PORT=5000
